root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.json]
indent_size = 2

# Fixed-width columns aligned by hand; nothing may re-indent it.
[mappings.txt]
indent_style = unset
indent_size = unset
# A row can end inside its padding; trimming would shift the column.
trim_trailing_whitespace = unset
